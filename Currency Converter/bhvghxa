import os
import re
import pandas as pd
import logging
from sqlalchemy import create_engine, MetaData, Table, Column, String, CLOB
from sqlalchemy.exc import SQLAlchemyError
from sqlalchemy.dialects.oracle import CLOB as OracleCLOB
from logging.handlers import RotatingFileHandler

# ======================================================
# CONFIGURATION
# ======================================================
USERNAME = "your_username"
PASSWORD = "your_password"
DNS = "hostname:1521/servicename"  # example: "10.12.45.20:1521/ORCLPDB1"

ROOT_PATH = r"\\atlsa\gys\GWMP\PgsT\Pe22.32\Results"  # base directory
MAX_COLS = 40
STORY_REGEX = r"US\d+"  # user story ID pattern

# ======================================================
# LOGGING CONFIGURATION
# ======================================================
logger = logging.getLogger("excel_oracle_ingest")
logger.setLevel(logging.INFO)
handler = RotatingFileHandler("excel_ingest.log", maxBytes=5*1024*1024, backupCount=3)
formatter = logging.Formatter('%(asctime)s [%(levelname)s] %(message)s')
handler.setFormatter(formatter)
logger.addHandler(handler)

# ======================================================
# DATABASE INITIALIZATION
# ======================================================
DB_URL = f"oracle+cx_oracle://{USERNAME}:{PASSWORD}@{DNS}"

engine = create_engine(DB_URL)
metadata = MetaData()

# Define a table with 40 CLOB columns
columns = [Column("story_id", String(50), primary_key=True)]
for i in range(1, MAX_COLS + 1):
    columns.append(Column(f"col{i}", OracleCLOB))

story_data = Table("story_data", metadata, *columns)
metadata.create_all(engine, checkfirst=True)

# ======================================================
# HELPER FUNCTIONS
# ======================================================
def find_excel_files(root):
    excel_files = []
    for dirpath, _, filenames in os.walk(root):
        for f in filenames:
            if f.lower().endswith((".xlsx", ".xls")):
                excel_files.append(os.path.join(dirpath, f))
    return excel_files

def extract_story_id(df):
    # Search for US pattern in entire DataFrame
    try:
        text_data = df.astype(str).values.ravel()
        matches = [re.search(STORY_REGEX, str(val), re.IGNORECASE) for val in text_data]
        matches = [m.group(0).upper() for m in matches if m]
        if matches:
            return matches[0]
    except Exception as e:
        logger.error(f"Error while scanning for story ID: {e}")
    return None

def flatten_excel_data(df):
    values = df.astype(str).values.flatten().tolist()
    if len(values) > MAX_COLS:
        logger.warning(f"Truncating {len(values)} values to {MAX_COLS}")
        values = values[:MAX_COLS]
    elif len(values) < MAX_COLS:
        values += [None] * (MAX_COLS - len(values))
    return values

def ingest_file(file_path, conn):
    try:
        df = pd.read_excel(file_path)
        if df.empty:
            logger.warning(f"Skipped empty file: {file_path}")
            return

        story_id = extract_story_id(df)
        if not story_id:
            logger.warning(f"No Story ID found in file: {file_path}")
            return

        values = flatten_excel_data(df)
        row = {"story_id": story_id}
        for i in range(MAX_COLS):
            row[f"col{i+1}"] = values[i]

        with conn.begin():
            conn.execute(story_data.insert().values(**row))
        logger.info(f"✅ Inserted story {story_id} from {os.path.basename(file_path)}")

    except SQLAlchemyError as e:
        logger.error(f"Database error for file {file_path}: {e}", exc_info=True)
    except Exception as e:
        logger.error(f"Error processing file {file_path}: {e}", exc_info=True)

# ======================================================
# MAIN SCRIPT EXECUTION
# ======================================================
if __name__ == "__main__":
    files = find_excel_files(ROOT_PATH)
    logger.info(f"📁 Found {len(files)} Excel files to process in {ROOT_PATH}")

    with engine.connect() as conn:
        for file_path in files:
            ingest_file(file_path, conn)

    logger.info("🏁 Data ingestion completed successfully.")
