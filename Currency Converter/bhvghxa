import os
import re
import pandas as pd
import logging
from sqlalchemy import create_engine, MetaData, Table, Column, String
from sqlalchemy.dialects.oracle import CLOB as OracleCLOB
from sqlalchemy.exc import SQLAlchemyError
from logging.handlers import RotatingFileHandler

# ======================================================
# CONFIGURATION
# ======================================================
USERNAME = "your_username"
PASSWORD = "your_password"
HOST = "your_hostname"        # e.g. 10.20.30.40
PORT = "1521"
SERVICE_NAME = "orclpdb1"

ROOT_PATH = r"\\atlsa\gys\GWMP\PgsT\Pe22.32\Results"
MAX_COLS = 40
STORY_REGEX = r"US\d+"

# ======================================================
# LOGGING CONFIGURATION
# ======================================================
logger = logging.getLogger("excel_oracle_ingest")
logger.setLevel(logging.INFO)
handler = RotatingFileHandler("excel_ingest.log", maxBytes=5*1024*1024, backupCount=3)
formatter = logging.Formatter('%(asctime)s [%(levelname)s] %(message)s')
handler.setFormatter(formatter)
logger.addHandler(handler)

# ======================================================
# DATABASE INITIALIZATION
# ======================================================
DB_URL = f"oracle+oracledb://{USERNAME}:{PASSWORD}@{HOST}:{PORT}/?service_name={SERVICE_NAME}"
engine = create_engine(DB_URL)
metadata = MetaData()

columns = [Column("story_id", String(50))]
for i in range(1, MAX_COLS + 1):
    columns.append(Column(f"col{i}", OracleCLOB))

story_data = Table("story_data", metadata, *columns)
metadata.create_all(engine, checkfirst=True)

# ======================================================
# HELPER FUNCTIONS
# ======================================================

def find_excel_files(root):
    """Recursively find all Excel files."""
    excel_files = []
    for dirpath, _, filenames in os.walk(root):
        for f in filenames:
            if f.lower().endswith((".xlsx", ".xls")):
                excel_files.append(os.path.join(dirpath, f))
    return excel_files


def extract_story_id(df):
    """Find the first occurrence of USxxxxx pattern in the file."""
    try:
        text_data = df.astype(str).values.ravel()
        for val in text_data:
            match = re.search(STORY_REGEX, str(val), re.IGNORECASE)
            if match:
                return match.group(0).upper()
    except Exception as e:
        logger.error(f"Error extracting story ID: {e}")
    return None


def clean_value(val):
    """Convert blank/NaN to None for SQL NULLs."""
    if pd.isna(val):
        return None
    val_str = str(val).strip()
    if val_str.lower() in ("", "nan", "none", "null"):
        return None
    return val_str


def prepare_row_data(row_values):
    """Ensure row has up to MAX_COLS columns."""
    cleaned = [clean_value(v) for v in row_values]
    if len(cleaned) > MAX_COLS:
        logger.warning(f"Row with {len(cleaned)} cells truncated to {MAX_COLS}")
        cleaned = cleaned[:MAX_COLS]
    elif len(cleaned) < MAX_COLS:
        cleaned += [None] * (MAX_COLS - len(cleaned))
    return cleaned


def ingest_file(file_path, conn):
    """Insert every row from Excel into Oracle DB."""
    try:
        # Read file with header=None to capture all rows & cells exactly
        df = pd.read_excel(file_path, header=None, engine="openpyxl")
        if df.empty:
            logger.warning(f"Skipped empty file: {file_path}")
            return

        story_id = extract_story_id(df)
        if not story_id:
            logger.warning(f"No story ID found in {file_path}")
            return

        inserted_rows = 0
        for _, row in df.iterrows():
            values = prepare_row_data(row.tolist())
            record = {"story_id": story_id}
            for i in range(MAX_COLS):
                record[f"col{i+1}"] = values[i]

            with conn.begin():
                conn.execute(story_data.insert().values(**record))
            inserted_rows += 1

        logger.info(f"{inserted_rows} rows inserted for {story_id} from {os.path.basename(file_path)}")
        print(f"{inserted_rows} rows inserted for {story_id} from {os.path.basename(file_path)}")

    except SQLAlchemyError as e:
        logger.error(f"Database error for {file_path}: {e}", exc_info=True)
    except Exception as e:
        logger.error(f"Error processing {file_path}: {e}", exc_info=True)

# ======================================================
# MAIN SCRIPT
# ======================================================
if __name__ == "__main__":
    print("Starting Excel ingestion...")
    logger.info(f"Scanning directory: {ROOT_PATH}")

    files = find_excel_files(ROOT_PATH)
    print(f"Found {len(files)} Excel files to process.")
    logger.info(f"Found {len(files)} Excel files to process.")

    if not files:
        print("No Excel files found. Exiting.")
        logger.warning("No Excel files found. Exiting.")
        exit()

    with engine.connect() as conn:
        for file_path in files:
            print(f"Processing: {file_path}")
            ingest_file(file_path, conn)

    print("Data ingestion completed successfully.")
    logger.info("Data ingestion completed successfully.")
